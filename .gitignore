# Data (кроме маленьких примеров)
data/*.jsonl
!data/alpaca_subset.json

# Seeds (сохраняем структуру, но не сами файлы)
seeds/*.json
!seeds/README.md

# Experiments results (сохраняем README, но не большие файлы)
experiments/*/results/*.json
experiments/*/results/*.png
experiments/*/activations/*.json
experiments/*/visualizations/*.png
!experiments/*/results/README.md
!experiments/*/activations/README.md
!experiments/*/visualizations/README.md

